// Distributed Lock persistence model — PostgreSQL fencing token sequence.
// The active lease itself remains in Redis; this table provides durable
// monotonic fencing tokens so downstream resources can reject stale owners.

model DistributedLock {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.VarChar(100)
  organizationId String   @map("organization_id") @db.VarChar(100)
  scope          String   @db.VarChar(200)
  resource       String   @db.VarChar(500)
  fencingToken   BigInt   @default(0) @map("fencing_token")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, organizationId, scope, resource])
  @@index([tenantId, organizationId])
  @@map("distributed_locks")
}
