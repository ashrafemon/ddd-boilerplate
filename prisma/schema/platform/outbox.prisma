// Transactional Outbox persistence model. Written inside the same DB
// transaction as the aggregate change and published by the outbox scheduler
// (see docs/design 04). Claim safety: rows keep status=PENDING while claimed —
// FOR UPDATE SKIP LOCKED stamps claimToken + claimedAt as the lease and bumps
// attempts; a crashed owner is reclaimed once its lease expires (nextRetryAt
// drives backoff). DEAD_LETTER is the terminal park state for poison messages.
model OutboxMessage {
  id            String              @id @default(uuid()) @db.Uuid
  eventId       String              @unique @map("event_id") @db.Uuid
  eventVersion  Int                 @default(1) @map("event_version")
  tenantId      String?             @map("tenant_id") @db.VarChar(100)
  organizationId String?            @map("organization_id") @db.VarChar(100)
  eventType     String              @map("event_type") @db.VarChar(250)
  aggregateType String              @map("aggregate_type") @db.VarChar(200)
  aggregateId   String              @map("aggregate_id") @db.Uuid
  payload       Json
  headers       Json?
  occurredAt    DateTime            @map("occurred_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  status        OutboxMessageStatus @default(PENDING)
  nextRetryAt   DateTime?           @map("next_retry_at")
  attempts      Int                 @default(0)
  claimedAt     DateTime?           @map("claimed_at")
  claimToken    String?             @map("claim_token") @db.Uuid
  publishedAt   DateTime?           @map("published_at")
  lastError     String?             @map("last_error") @db.Text
  correlationId String?             @map("correlation_id") @db.VarChar(200)
  causationId   String?             @map("causation_id") @db.VarChar(200)
  version       Int                 @default(1)

  @@index([status, nextRetryAt])
  @@index([tenantId, organizationId, status])
  @@index([claimedAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_messages")
}

enum OutboxMessageStatus {
  PENDING
  PUBLISHED
  DEAD_LETTER
}
