// ============================================================================
// Platform — Saga: cross-aggregate orchestration (design 08).
// Five tables — the workbook's `DB Tables` set minus `saga_company_overlays`,
// which is intentionally NOT implemented: plans come from the platform
// definition only (no per-company narrowing source exists yet).
//   saga_definitions      platform defaults, found by (event_name, event_version)
//   saga_instances        one live row per correlation key, holds the plan snapshot
//   saga_steps            durable work queue + execution log + audit (id = idempotency key)
//   saga_outbox           the saga's own publication ledger (onComplete.emit, lifecycle events)
//   saga_inbox            dedupe by (tenant, company, consumer, event)
// Column names follow the workbook's `DB Tables` sheet (`saga_definitions`,
// `saga_instances`, `saga_steps`, `saga_outbox`, `saga_inbox`), so hand-written
// SQL MUST use the snake_case names.
//
// Platform extensions the workbook does not carry (declared here so nobody reads
// them as drift): `saga_steps.action`, `saga_inbox.instance_id`/`reason`/
// `received_at`, the `live_key` guard and the `created_at`/`updated_at`
// timestamps, plus
// `saga_outbox.causation_id`/`created_at`/`version` (shared with `outbox_messages`
// so one ledger implementation serves both tables).
//
// One live instance per (tenant, company, saga_key, correlation_key): Prisma cannot
// express a partial unique index, so the row carries a nullable `live_key` with a
// plain unique constraint. The repository sets it while the instance is live and
// NULLs it on every terminal transition — NULLs never collide, which is exactly the
// `WHERE status IN ('RUNNING','WAITING','COMPENSATING')` predicate.
//
// Tenancy: every row is scoped by (tenantId, companyId); every query filters both.
// ============================================================================

enum SagaDefinitionStatus {
  DRAFT
  ACTIVE
  /** Published but no longer executable (bad expression / missing action). */
  INVALID
  RETIRED

  @@map("saga_definition_status")
}

enum SagaInstanceState {
  RUNNING
  WAITING
  COMPENSATING
  COMPLETED
  COMPENSATED
  CANCELLED
  FAILED_MANUAL

  @@map("saga_instance_state")
}

enum SagaInstanceReason {
  STEP_FAILED
  TIMEOUT
  CANCELLED_BY_EVENT
  CANCELLED_BY_USER

  @@map("saga_instance_reason")
}

enum SagaStepKind {
  DO
  WAIT
  UNDO

  @@map("saga_step_kind")
}

enum SagaStepState {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED

  @@map("saga_step_state")
}

enum SagaInboxState {
  RECEIVED
  BUFFERED
  CONSUMED
  IGNORED

  @@map("saga_inbox_state")
}

model SagaDefinition {
  id           String               @id @default(uuid()) @db.Uuid
  /**
   * Owning business module (`purchase-order`) — authorization + discovery.
   */
  ownerModule  String?              @map("owner_module") @db.VarChar(200)
  sagaKey      String               @map("saga_key") @db.VarChar(200)
  version      Int
  eventName    String               @map("event_name") @db.VarChar(250)
  eventVersion Int                  @map("event_version")
  status       SagaDefinitionStatus @default(DRAFT)
  definition   Json
  createdBy    String?              @map("created_by") @db.VarChar(200)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([sagaKey, version])
  @@index([eventName, eventVersion, status])
  @@map("saga_definitions")
}

model SagaInstance {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @map("tenant_id") @db.VarChar(100)
  companyId         String              @map("company_id") @db.VarChar(100)
  sagaKey           String              @map("saga_key") @db.VarChar(200)
  definitionId      String              @map("definition_id") @db.Uuid
  /**
   * Workbook column kept for contract fidelity. No overlay source exists (see the
   * header), so it stays NULL until one is introduced.
   */
  configId          String?             @map("config_id") @db.Uuid
  rootRefType       String?             @map("root_ref_type") @db.VarChar(200)
  rootRefId         String?             @map("root_ref_id") @db.VarChar(200)
  correlationKey    String              @map("correlation_id") @db.VarChar(250)
  /**
   * Live-instance guard: `<sagaKey>\u0000<correlationKey>` while RUNNING/WAITING/
   * COMPENSATING, NULL once terminal. Unique, so the DB — not a read-then-write —
   * decides whether a second live instance may exist.
   */
  liveKey           String?             @unique @map("live_key") @db.VarChar(500)
  status            SagaInstanceState   @default(RUNNING)
  reason            SagaInstanceReason?
  plan              Json
  context           Json
  cursor            Int                 @default(0)
  waitingEvent      String?             @map("waiting_event") @db.VarChar(250)
  cancelRequestedAt DateTime?           @map("cancel_requested_at")
  lastError         String?             @map("last_error") @db.Text
  deadlineAt        DateTime?           @map("deadline_at")
  startedAt         DateTime?           @map("started_at")
  finishedAt        DateTime?           @map("finished_at")
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([tenantId, companyId, status])
  @@index([tenantId, companyId, sagaKey, status])
  @@index([sagaKey, correlationKey])
  @@map("saga_instances")
}

model SagaStep {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.VarChar(100)
  companyId    String        @map("company_id") @db.VarChar(100)
  instanceId   String        @map("instance_id") @db.Uuid
  stepId       String        @map("step_id") @db.VarChar(200)
  kind         SagaStepKind
  /**
   * Platform extension: the registered `SagaAction` name for DO/UNDO rows.
   */
  action       String?       @db.VarChar(250)
  /**
   * WAIT rows park on an event contract instead of an action.
   */
  eventName    String?       @map("event_name") @db.VarChar(250)
  eventVersion Int?          @map("event_version")
  status       SagaStepState @default(PENDING)
  attempts     Int           @default(0) @map("attempts")
  maxAttempts  Int           @map("max_attempts")
  runAt        DateTime      @map("run_at")
  lockedBy     String?       @map("locked_by") @db.VarChar(200)
  lockUntil    DateTime?     @map("lock_until")
  input        Json?
  output       Json?
  lastError    String?       @map("last_error") @db.Text
  startedAt    DateTime?     @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([instanceId, stepId, kind])
  @@index([status, runAt])
  @@index([companyId, status])
  @@map("saga_steps")
}

model SagaInbox {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.VarChar(100)
  companyId      String         @map("company_id") @db.VarChar(100)
  consumer       String         @map("consumer_key") @db.VarChar(250)
  /**
   * Platform event id; the workbook calls this `message_id`.
   */
  eventId        String         @map("message_id") @db.VarChar(500)
  eventName      String         @map("event_name") @db.VarChar(250)
  eventVersion   Int            @map("event_version")
  correlationKey String?        @map("correlation_id") @db.VarChar(250)
  instanceId     String?        @map("instance_id") @db.Uuid
  payload        Json
  payloadHash    String?        @map("payload_hash") @db.VarChar(128)
  headers        Json?
  status         SagaInboxState @default(RECEIVED)
  reason         String?        @db.VarChar(250)
  attempts       Int            @default(0) @map("attempts")
  claimToken     String?        @map("claim_token") @db.Uuid
  claimedAt      DateTime?      @map("claimed_at")
  receivedAt     DateTime       @default(now()) @map("received_at")
  processedAt    DateTime?      @map("processed_at")
  nextAttemptAt  DateTime?      @map("next_attempt_at")
  lastError      String?        @map("last_error") @db.Text

  @@unique([tenantId, companyId, consumer, eventId])
  @@index([instanceId, status])
  @@index([status, nextAttemptAt])
  @@map("saga_inbox")
}

/**
 * The saga's own publication ledger (workbook `saga_outbox`).
 * Column-for-column identical to `outbox_messages` on purpose: one ledger
 * implementation (`OutboxLedgerRepository`) serves both tables, so the saga can
 * isolate its lifecycle traffic (`onComplete.emit`) behind its own claim,
 * retry and retention policy without a second copy of the state machine.
 * Status set is the workbook's shared one: PENDING | PUBLISHING | PUBLISHED |
 * FAILED | DEAD_LETTER (see `outbox.prisma`).
 */
model SagaOutboxMessage {
  id String @id @default(uuid()) @db.Uuid

  tenantId  String? @map("tenant_id") @db.VarChar(100)
  companyId String? @map("company_id") @db.VarChar(100)

  /**
   * Broker-facing message identity; consumers dedupe on it.
   */
  messageId    String @unique @map("message_id") @db.VarChar(200)
  eventName    String @map("event_name") @db.VarChar(250)
  eventVersion Int    @default(1) @map("event_version")

  aggregateType    String @map("aggregate_type") @db.VarChar(200)
  aggregateId      String @map("aggregate_id") @db.VarChar(200)
  aggregateVersion Int?   @map("aggregate_version")

  payload    Json
  headers    Json?
  occurredAt DateTime @map("occurred_at")

  status      OutboxMessageStatus @default(PENDING)
  attempts    Int                 @default(0)
  claimToken  String?             @map("claim_token") @db.Uuid
  claimedAt   DateTime?           @map("claimed_at")
  availableAt DateTime?           @map("available_at")
  publishedAt DateTime?           @map("published_at")
  lastError   String?             @map("last_error") @db.Text

  correlationId String? @map("correlation_id") @db.VarChar(200)
  causationId   String? @map("causation_id") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  version   Int      @default(1)

  @@index([status, availableAt])
  @@index([tenantId, companyId, status])
  @@index([claimedAt])
  @@index([aggregateType, aggregateId])
  @@map("saga_outbox")
}
