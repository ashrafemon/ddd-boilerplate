// ============================================================================
// Platform — Saga: company-configurable cross-aggregate orchestration
// (design 08). Five tables:
//   saga_definitions      platform defaults, found by (event_name, event_version)
//   saga_company_configs  one ACTIVE overlay per (company, saga_key) — narrows only
//   saga_instances        one live row per correlation key, holds the plan snapshot
//   saga_steps            durable work queue + execution log + audit (id = idempotency key)
//   saga_inbox            dedupe by (tenant, company, consumer, event)
// Partial uniques are hand-written in the migration (Prisma cannot express them).
// Tenancy: every row is scoped by (tenantId, companyId); every query filters both.
// ============================================================================

enum SagaDefinitionStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("saga_definition_status")
}

enum SagaCompanyConfigStatus {
  ACTIVE
  INVALID
  RETIRED

  @@map("saga_company_config_status")
}

enum SagaInstanceState {
  RUNNING
  WAITING
  COMPENSATING
  COMPLETED
  COMPENSATED
  CANCELLED
  FAILED_MANUAL

  @@map("saga_instance_state")
}

enum SagaInstanceReason {
  STEP_FAILED
  TIMEOUT
  CANCELLED_BY_EVENT
  CANCELLED_BY_USER

  @@map("saga_instance_reason")
}

enum SagaStepKind {
  DO
  WAIT
  UNDO

  @@map("saga_step_kind")
}

enum SagaStepState {
  PENDING
  RUNNING
  DONE
  SKIPPED
  FAILED

  @@map("saga_step_state")
}

enum SagaInboxState {
  RECEIVED
  BUFFERED
  CONSUMED
  IGNORED

  @@map("saga_inbox_state")
}

model SagaDefinition {
  id           String               @id @default(uuid()) @db.Uuid
  sagaKey      String               @map("saga_key") @db.VarChar(200)
  version      Int
  eventName    String               @map("event_name") @db.VarChar(250)
  eventVersion Int                  @map("event_version")
  status       SagaDefinitionStatus @default(DRAFT)
  definition   Json
  createdBy    String?              @map("created_by") @db.VarChar(200)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([sagaKey, version])
  @@index([eventName, eventVersion, status])
  @@map("saga_definitions")
}

model SagaCompanyConfig {
  id           String                  @id @default(uuid()) @db.Uuid
  tenantId     String                  @map("tenant_id") @db.VarChar(100)
  companyId String                @map("company_id") @db.VarChar(100)
  definitionId String                  @map("definition_id") @db.Uuid
  sagaKey      String                  @map("saga_key") @db.VarChar(200)
  version      Int                     @default(1)
  baseVersion  Int                     @map("base_version")
  overlay      Json
  status       SagaCompanyConfigStatus @default(ACTIVE)
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([companyId, sagaKey, version])
  @@index([tenantId, companyId, sagaKey, status])
  @@map("saga_company_configs")
}

model SagaInstance {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @map("tenant_id") @db.VarChar(100)
  companyId    String             @map("company_id") @db.VarChar(100)
  sagaKey           String             @map("saga_key") @db.VarChar(200)
  definitionId      String             @map("definition_id") @db.Uuid
  configId          String?            @map("config_id") @db.Uuid
  rootRefType       String?            @map("root_ref_type") @db.VarChar(200)
  rootRefId         String?            @map("root_ref_id") @db.VarChar(200)
  correlationKey    String             @map("correlation_key") @db.VarChar(250)
  status            SagaInstanceState  @default(RUNNING)
  reason            SagaInstanceReason?
  plan              Json
  context           Json
  cursor            Int                @default(0)
  waitingEvent      String?            @map("waiting_event") @db.VarChar(250)
  cancelRequestedAt DateTime?          @map("cancel_requested_at")
  error             String?            @db.Text
  deadlineAt        DateTime?          @map("deadline_at")
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([tenantId, companyId, status])
  @@index([tenantId, companyId, sagaKey, status])
  @@index([sagaKey, correlationKey])
  @@map("saga_instances")
}

model SagaStep {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.VarChar(100)
  companyId String     @map("company_id") @db.VarChar(100)
  instanceId  String        @map("instance_id") @db.Uuid
  stepId      String        @map("step_id") @db.VarChar(200)
  kind        SagaStepKind
  action      String?       @db.VarChar(250)
  status      SagaStepState @default(PENDING)
  attempt     Int           @default(0)
  maxAttempts Int           @map("max_attempts")
  runAt       DateTime      @map("run_at")
  lockedBy    String?       @map("locked_by") @db.VarChar(200)
  lockUntil   DateTime?     @map("lock_until")
  input       Json?
  output      Json?
  error       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([instanceId, stepId, kind])
  @@index([status, runAt])
  @@index([companyId, status])
  @@map("saga_steps")
}

model SagaInbox {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.VarChar(100)
  companyId String         @map("company_id") @db.VarChar(100)
  consumer      String          @db.VarChar(200)
  eventId       String          @map("event_id") @db.Uuid
  eventName     String          @map("event_name") @db.VarChar(250)
  eventVersion  Int             @map("event_version")
  correlationKey String?        @map("correlation_key") @db.VarChar(250)
  instanceId    String?         @map("instance_id") @db.Uuid
  payload       Json
  status        SagaInboxState  @default(RECEIVED)
  reason        String?         @db.VarChar(250)
  receivedAt    DateTime        @default(now()) @map("received_at")
  processedAt   DateTime?       @map("processed_at")

  @@unique([tenantId, companyId, consumer, eventId])
  @@index([instanceId, status])
  @@map("saga_inbox")
}
