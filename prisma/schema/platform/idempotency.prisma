// ============================================================================
// Platform — Idempotency (idempotency.prisma)
// ============================================================================
// Reservation ledger backing the IdempotencyPort and the @Idempotent()
// HTTP decorator. A key is inserted as IN_PROGRESS before the operation runs,
// then CAS-marked COMPLETED (with the response snapshot for replay) or
// CAS-deleted by fail() so the next call starts clean. COMPLETED results are
// mirrored to Redis for fast replay; Postgres stays authoritative for claims.
// Expired rows are purged hourly by IdempotencyReconciliation.
//
// Multi-tenancy: (tenantId, companyId, scope, key) is the natural
// identity. The same key in another tenant/company is a different record.
// ============================================================================

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED

  @@map("idempotency_status")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid

  tenantId       String   @map("tenant_id") @db.VarChar(100)
  companyId String   @map("company_id") @db.VarChar(100)
  scope          String   @db.VarChar(200)
  key            String   @db.VarChar(500)

  requestHash    String?  @map("request_hash") @db.VarChar(128)

  status         IdempotencyStatus @default(IN_PROGRESS)

  claimToken     String   @map("claim_token") @db.Uuid
  version        Int      @default(1)

  resultJson     Json?    @map("result_json")

  claimedAt      DateTime? @map("claimed_at")
  completedAt    DateTime? @map("completed_at")

  expiresAt      DateTime @map("expires_at")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, companyId, scope, key])
  @@index([expiresAt])
  @@index([status, claimedAt])
  @@index([tenantId, companyId])
  @@map("idempotency_keys")
}
