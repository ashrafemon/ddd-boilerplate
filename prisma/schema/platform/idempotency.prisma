// ============================================================================
// Platform — Idempotency (idempotency.prisma)
// ============================================================================
// Reservation ledger backing the IdempotencyPort and the @Idempotent()
// HTTP decorator. A key is reserved (INSERT) before the operation runs, then
// marked COMPLETED (with the response snapshot for replay) or FAILED
// (releasable for retry). Expired IN_PROGRESS claims are reconciled to
// SUSPENDED. Expiry is swept by the idempotency reconciler.
//
// Multi-tenancy: (tenantId, organizationId, scope, key) is the natural
// identity — callers encode the operation key (e.g. a client Idempotency-Key
// header); tenantId + organizationId scopes it so two tenants/organizations
// may reuse the same key string.
// ============================================================================

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  SUSPENDED

  @@map("idempotency_status")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid

  tenantId       String   @map("tenant_id") @db.VarChar(100)
  organizationId String   @map("organization_id") @db.VarChar(100)
  scope          String   @db.VarChar(200)
  key            String   @db.VarChar(500)

  requestHash    String?  @map("request_hash") @db.VarChar(128)

  status         IdempotencyStatus @default(IN_PROGRESS)

  claimToken     String   @map("claim_token") @db.Uuid
  version        Int      @default(1)

  resultJson     Json?    @map("result_json")

  errorCode      String?  @map("error_code") @db.VarChar(100)
  errorMessage   String?  @map("error_message") @db.Text

  claimedAt      DateTime? @map("claimed_at")
  completedAt    DateTime? @map("completed_at")

  expiresAt      DateTime @map("expires_at")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, organizationId, scope, key])
  @@index([expiresAt])
  @@index([status, claimedAt])
  @@index([tenantId, organizationId])
  @@map("idempotency_keys")
}
