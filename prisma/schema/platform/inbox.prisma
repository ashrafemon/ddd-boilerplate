// ============================================================================
// Platform — Inbox (inbox.prisma)
// ============================================================================
// Consumer-side counterpart of Outbox (design 07): guarantees that the same
// logical message + the same consumer gives exactly one business execution
// under at-least-once redelivery. No business rules, no broker knowledge.
//
// Identity is (tenantId, companyId, consumer, messageId); NULLs are
// normalized to '' at the repository edge so the unique constraint still bites.
//
// Statuses: IN_PROGRESS | PROCESSED | SUSPENDED. `fail` keeps a row IN_PROGRESS
// with a backoff `nextAttemptAt` (the broker redelivers); the reconciler parks
// poison past `maxAttempts` as SUSPENDED and deletes PROCESSED past retention.
// ============================================================================

enum InboxMessageStatus {
  IN_PROGRESS
  PROCESSED
  SUSPENDED

  @@map("inbox_message_status")
}

model InboxMessage {
  id             String            @id @default(uuid()) @db.Uuid

  tenantId       String            @default("") @map("tenant_id") @db.VarChar(100)
  companyId String            @default("") @map("company_id") @db.VarChar(100)
  consumer       String            @db.VarChar(250)
  messageId      String            @map("message_id") @db.VarChar(500)

  messageType    String            @map("message_type") @db.VarChar(250)
  payload        Json

  status         InboxMessageStatus @default(IN_PROGRESS)
  attempts       Int               @default(1)

  claimToken     String            @map("claim_token") @db.Uuid
  claimedAt      DateTime?         @map("claimed_at")
  processedAt    DateTime?         @map("processed_at")
  nextAttemptAt  DateTime?         @map("next_attempt_at")
  lastError      String?           @map("last_error") @db.Text

  correlationId  String?           @map("correlation_id") @db.VarChar(200)
  causationId    String?           @map("causation_id") @db.VarChar(200)

  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([tenantId, companyId, consumer, messageId])
  @@index([status, nextAttemptAt])
  @@map("inbox_messages")
}
