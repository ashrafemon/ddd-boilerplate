// Inventory — StockMovement ledger (design common, Phase 5).
// Balances are a projection updated in the same transaction as the movement insert.
// @@unique([grnLineId, movementType]) = natural idempotency for redelivery.
//
// Table contract:
//   grnLineId — the SOURCE LINE reference `${grnId}:${productId}` (GRN lines are
//     identified by the composite (grnId, productId); there is no surrogate line
//     id in the domain), hence TEXT, not uuid.
//   movementType — GOODS_RECEIPT | GOODS_RECEIPT_REVERSAL (compensating entries).
//   reversalOfId — id of the original movement this entry compensates (nullable).

model StockMovement {
  id                String        @id @default(uuid()) @db.Uuid
  grnLineId         String        @map("grn_line_id")
  productId         String        @map("product_id") @db.Uuid
  quantity          Int
  movementType      String        @map("movement_type") @db.VarChar(50)
  sourceDocumentId  String        @map("source_document_id") @db.VarChar(200)
  sourceDocumentType String       @map("source_document_type") @db.VarChar(100)
  companyId         String        @map("company_id") @db.VarChar(100)
  tenantId          String        @map("tenant_id") @db.VarChar(100)
  actorId           String?       @map("actor_id") @db.VarChar(200)
  effectiveDate     DateTime      @map("effective_date")
  reversalOfId      String?       @map("reversal_of_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")

  @@unique([grnLineId, movementType])
  @@index([productId])
  @@index([companyId])
  @@index([tenantId])
  @@map("inventory_movements")
}

// Stock on-hand PROJECTION — never edited directly; always derived from the
// inventory_movements ledger and upserted in the SAME transaction as each
// movement insert (plan Phase 5.2 / GRN-04), so "balances reconcile to the
// movement sum" holds by construction.
model StockBalance {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  companyId String   @map("company_id") @db.VarChar(100)
  tenantId  String   @map("tenant_id") @db.VarChar(100)
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, companyId, tenantId])
  @@map("stock_balances")
}
