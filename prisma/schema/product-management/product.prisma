// Product Management context — Product aggregate (cross-functional master data).
// Product moved out of Procurement into its own Product Management bounded context.
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  unitPrice   Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD") @db.VarChar(3)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  version     Int           @default(1)
  tenantId    String?
  companyId   String        @default("00000000-0000-0000-0000-000000000000")

  @@index([tenantId])
  @@index([companyId])
  @@unique([companyId, sku])
  @@index([status])
  @@index([createdAt])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}
