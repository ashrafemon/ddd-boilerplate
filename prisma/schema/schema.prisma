// Prisma schema root — PostgreSQL + Prisma Client (v7, driver adapter via prisma.config.ts)
// This file aggregates the domain models. Each aggregate lives in its own *.prisma file
// within the same directory so the schema stays navigable as the ERP grows.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
