// PurchaseOrder aggregate persistence model. Owns its lines; references
// products and vendors only by id (aggregate boundary).
//
// Table contract — commercial + actor columns (plan Phase 1.2 / 2.2 / 2.3):
//   orderDate / expectedDeliveryDate — commercial header, nullable, editable only in DRAFT.
//   createdBy/approvedBy/rejectedBy/issuedBy/cancelledBy + approval timestamps/reason —
//   actor trail written from RequestContextPort; nullable, never backfilled (E-4).
//   approval record: approvedAt/rejectedAt/rejectionReason (Phase 2.3, minimal).
model PurchaseOrder {
  id          String                @id @default(uuid()) @db.Uuid
  orderNumber String                @unique
  // Caller-supplied reference (import poReference). Groups import rows into one PO and
  // makes re-imports find-or-create; NULL for POs created any other way.
  externalReference String?           @unique @db.VarChar(128)
  vendorId    String                @db.Uuid
  status      PurchaseOrderStatus   @default(DRAFT)
  currency    String                @default("USD") @db.VarChar(3)
  subtotal    Decimal               @default(0) @db.Decimal(18, 2)
  total       Decimal               @default(0) @db.Decimal(18, 2)
  // Commercial header (spec §3.1).
  orderDate            DateTime?
  expectedDeliveryDate DateTime?
  // Actor & approval trail (plan §1.2 / §2.3) — nullable, no backfill.
  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  issuedBy        String?
  cancelledBy     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  version     Int                   @default(1)
  lines       PurchaseOrderLine[]

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id            String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String      @db.Uuid
  productId     String        @db.Uuid
  quantity      Int
  receivedQuantity Int        @default(0)
  // Commercial snapshot from the product master at add/issue time (spec §3.2/§3.3):
  // a later product rename must not silently change this PO's agreed description.
  descriptionSnapshot String?
  unitPrice     Decimal       @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, productId])
  @@index([productId])
  @@map("purchase_order_lines")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ISSUED
  REJECTED
  CANCELLED
  COMPLETED
}
