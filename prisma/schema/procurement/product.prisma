// Product aggregate persistence model.
// Mapped by infrastructure/database/mappers/ProductMapper into the domain aggregate.
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sku         String        @unique
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  unitPrice   Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD") @db.VarChar(3)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  version     Int           @default(1)

  @@index([status])
  @@index([createdAt])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}
