// Product aggregate persistence model.
// Mapped by infrastructure/database/mappers/ProductMapper into the domain aggregate.
model Product {
  id          String        @id @default(uuid()) @db.Uuid
  // Unique WITHIN the company — the same SKU may exist in two companies.
  sku         String
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  unitPrice   Decimal       @db.Decimal(18, 2)
  currency    String        @default("USD") @db.VarChar(3)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  version     Int           @default(1)
  // Tenancy — NULL = shared master data, visible to every tenant
  // (see shared-kernel/utils/tenant-scope.util.ts).
  tenantId    String?
  companyId   String        @default("00000000-0000-0000-0000-000000000000")

  @@index([tenantId])
  @@index([companyId])
  @@unique([companyId, sku])
  @@index([status])
  @@index([createdAt])
  @@map("products")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}
