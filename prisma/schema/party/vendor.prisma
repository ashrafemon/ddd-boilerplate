// Vendor aggregate persistence model.
model Vendor {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  email     String?
  phone     String?
  address   String?
  status    VendorStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  version   Int          @default(1)
  // Tenancy — NULL = shared master data, visible to every tenant.
  tenantId  String?
  companyId String?

  @@index([tenantId])
  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@map("vendors")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}
