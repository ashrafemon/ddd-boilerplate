// Vendor aggregate persistence model.
model Vendor {
  id        String       @id @default(uuid()) @db.Uuid
  // Unique WITHIN the company — the same code may exist in two companies.
  code      String
  name      String
  email     String?
  phone     String?
  address   String?
  status    VendorStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  version   Int          @default(1)
  // Tenancy — NULL = shared master data, visible to every tenant.
  tenantId  String?
  companyId String       @default("00000000-0000-0000-0000-000000000000")

  @@index([tenantId])
  @@index([companyId])
  @@unique([companyId, code])
  @@index([status])
  @@index([createdAt])
  @@map("vendors")
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}
