generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Platform / tenancy
// ─────────────────────────────────────────────────────────────
model Tenant {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
}

model Organization {
  id             String          @id @default(uuid())
  tenantId       String
  code           String
  name           String
  config         Json?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  users          User[]
  roles          Role[]
  vendors        Vendor[]
  products       Product[]
  productCategories ProductCategory[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model User {
  id             String   @id @default(uuid())
  tenantId       String
  organizationId String
  email          String
  name           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  roles          UserRole[]

  @@unique([tenantId, organizationId, email])
  @@index([tenantId, organizationId])
}

model Role {
  id             String   @id @default(uuid())
  tenantId       String
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  users          UserRole[]
  permissions    RolePermission[]

  @@unique([tenantId, organizationId, name])
  @@index([tenantId, organizationId])
}

model Permission {
  id        String @id @default(uuid())
  name      String
  roles     RolePermission[]
}

model UserRole {
  userId    String
  roleId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─────────────────────────────────────────────────────────────
// Vendor bounded context
// ─────────────────────────────────────────────────────────────
model Vendor {
  id             String          @id @default(uuid())
  tenantId       String
  organizationId String
  code           String
  name           String
  status         String          @default("ACTIVE") // ACTIVE | INACTIVE
  email          String?
  phone          String?
  taxIdentifier  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  addresses      VendorAddress[]
  contacts       VendorContact[]
  bankAccounts   VendorBankAccount[]

  @@unique([tenantId, organizationId, code])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
}

model VendorAddress {
  id             String   @id @default(uuid())
  vendorId       String
  tenantId       String
  organizationId String
  type           String // BILLING | SHIPPING | REGISTERED
  line1          String
  line2          String?
  city           String
  state          String?
  postalCode     String?
  country        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([tenantId, organizationId])
}

model VendorContact {
  id             String   @id @default(uuid())
  vendorId       String
  tenantId       String
  organizationId String
  firstName      String
  lastName       String
  email          String
  phone          String?
  role           String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([tenantId, organizationId])
}

model VendorBankAccount {
  id             String   @id @default(uuid())
  vendorId       String
  tenantId       String
  organizationId String
  accountName    String
  iban           String
  bankName       String?
  currency       String   @default("USD")
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([tenantId, organizationId])
}

// ─────────────────────────────────────────────────────────────
// Product bounded context
// ─────────────────────────────────────────────────────────────
model ProductCategory {
  id             String      @id @default(uuid())
  tenantId       String
  organizationId String
  code           String
  name           String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]

  @@unique([tenantId, organizationId, code])
  @@index([tenantId, organizationId])
}

model Product {
  id               String      @id @default(uuid())
  tenantId         String
  organizationId   String
  code             String
  name             String
  description      String?
  sku              String
  unit             String      @default("EA")
  status           String      @default("ACTIVE") // ACTIVE | INACTIVE
  isPurchasable    Boolean     @default(true)
  isSellable       Boolean     @default(true)
  priceCents       Int         @default(0)
  currency         String      @default("USD")
  categoryId       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  category         ProductCategory? @relation(fields: [categoryId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id])
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, organizationId, code])
  @@unique([tenantId, organizationId, sku])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, status])
}

// ─────────────────────────────────────────────────────────────
// Purchase bounded context
// ─────────────────────────────────────────────────────────────
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model PurchaseOrder {
  id               String               @id @default(uuid())
  tenantId         String
  organizationId   String
  number           String
  vendorId         String
  status           PurchaseOrderStatus  @default(DRAFT)
  currency         String               @default("USD")
  totalCents       Int                  @default(0)
  notes            String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  rejectedAt       DateTime?
  rejectedReason   String?
  cancelledAt      DateTime?
  cancelledReason  String?
  completedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organization     Organization         @relation(fields: [organizationId], references: [id])
  lines            PurchaseOrderLine[]

  @@unique([tenantId, organizationId, number])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, organizationId, vendorId])
}

model PurchaseOrderLine {
  id              String           @id @default(uuid())
  purchaseOrderId String
  tenantId        String
  organizationId  String
  lineNumber      Int
  productId       String
  description     String
  quantity        Decimal          @db.Decimal(18, 6)
  unitPriceCents  Int
  taxRateBps      Int              @default(0) // basis points, e.g. 250 = 2.5%
  netAmountCents  Int
  taxAmountCents  Int
  totalCents      Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  purchaseOrder   PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id])

  @@unique([purchaseOrderId, lineNumber])
  @@index([purchaseOrderId])
  @@index([tenantId, organizationId])
  @@index([tenantId, organizationId, productId])
}

// ─────────────────────────────────────────────────────────────
// Outbox / Inbox
// ─────────────────────────────────────────────────────────────
enum OutboxEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD_LETTER
}

model OutboxEvent {
  id             String            @id @default(uuid())
  eventId        String            @unique
  eventType      String
  aggregateType  String
  aggregateId    String
  tenantId       String
  organizationId String?
  correlationId  String?
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attemptCount   Int               @default(0)
  lastError      String?
  availableAt    DateTime          @default(now())
  lockedAt       DateTime?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, availableAt])
  @@index([tenantId, organizationId])
  @@index([aggregateType, aggregateId])
}

enum InboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  SKIPPED
}

model InboxEvent {
  id             String            @id @default(uuid())
  messageId      String
  eventType      String
  aggregateType  String?
  aggregateId    String?
  tenantId       String?
  organizationId String?
  correlationId  String?
  payload        Json?
  status         InboxEventStatus  @default(PENDING)
  attemptCount   Int               @default(0)
  lastError      String?
  processedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([messageId, eventType])
  @@index([status])
  @@index([tenantId, organizationId])
}
