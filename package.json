{
  "name": "erp-modular-monolith-boilerplate",
  "version": "1.0.0",
  "description": "Production-grade ERP backend boilerplate: NestJS + TypeScript + DDD + Hexagonal Architecture + Modular Monolith",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "arch:check": "ts-node scripts/check-architecture.ts"
  },
  "dependencies": {
    "@andreafspeziale/nestjs-memcached": "^3.8.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/client-ses": "^3.1106.0",
    "@aws-sdk/client-sns": "^3.1106.0",
    "@aws-sdk/client-sqs": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@golevelup/nestjs-rabbitmq": "^9.0.2",
    "@nestjs-cls/transactional": "^3.2.1",
    "@nestjs-cls/transactional-adapter-prisma": "^1.3.5",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.69.0",
    "@ssut/nestjs-sqs": "^3.0.1",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "nestjs-cls": "^6.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
