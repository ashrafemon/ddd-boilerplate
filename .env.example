# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
APP_NAME=erp-api
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
#   DATABASE_URL     = write / primary connection
#   DATABASE_URL_READ = read / replica connection (same value is fine for single node)
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://erp:erp@localhost:5432/erp?schema=public
DATABASE_URL_READ=postgresql://erp:erp@localhost:5432/erp?schema=public

# ─────────────────────────────────────────────────────────────
# Tenancy
# ─────────────────────────────────────────────────────────────
TENANT_HEADER=x-tenant-id
ORGANIZATION_HEADER=x-organization-id

# ─────────────────────────────────────────────────────────────
# Cache — Redis
# ─────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────
# Cache — Memcached
# ─────────────────────────────────────────────────────────────
MEMCACHED_ENABLED=false
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
MEMCACHED_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────
# Messaging — RabbitMQ
# ─────────────────────────────────────────────────────────────
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://erp:erp@localhost:5672
RABBITMQ_EXCHANGE=erp.events
RABBITMQ_QUEUE_PREFIX=erp

# ─────────────────────────────────────────────────────────────
# Messaging — Kafka
# ─────────────────────────────────────────────────────────────
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=erp-api
KAFKA_GROUP_ID=erp-consumer-group

# ─────────────────────────────────────────────────────────────
# Messaging — AWS SQS
# ─────────────────────────────────────────────────────────────
SQS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=

# ─────────────────────────────────────────────────────────────
# Storage — S3
# ─────────────────────────────────────────────────────────────
S3_ENABLED=false
S3_BUCKET=erp-files
S3_REGION=us-east-1
S3_PRESIGNED_URL_TTL_SECONDS=900

# ─────────────────────────────────────────────────────────────
# Notifications — AWS SNS / SES
# ─────────────────────────────────────────────────────────────
SNS_ENABLED=false
SNS_TOPIC_ARN=
SES_ENABLED=false
SES_FROM_ADDRESS=

# ─────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────
SENTRY_ENABLED=false
SENTRY_DSN=
PROMETHEUS_ENABLED=false
PROMETHEUS_METRICS_PATH=/metrics
LOKI_ENABLED=false
LOKI_URL=

# ─────────────────────────────────────────────────────────────
# Outbox dispatcher
# ─────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
