# ==================================================================
# Example Environment Configuration
# ==================================================================
# Copy this file to `.env` and fill in the values for your environment.
# Development defaults below match `docker-compose.yml`.
# ==================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=erp-api
LOG_LEVEL=info
PORT=4000
APP_URL=http://localhost:4000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
APP_HOST=0.0.0.0
SWAGGER_TITLE=ERP Boilerplate API
SWAGGER_DESCRIPTION=ERP platform — hexagonal architecture, DDD, event-driven modular monolith
SWAGGER_VERSION=1.0
SWAGGER_PATH=docs

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp-boilerplate?schema=public"
DATABASE_SLAVE_URL="postgresql://postgres:postgres@localhost:5432/erp-boilerplate?schema=public"

# --- Cache (Redis / Memcached) ---
CACHE_DRIVER=redis
REDIS_URL="redis://localhost:6379"
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211
MEMCACHED_TTL_SECONDS=300

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=erp.events

# --- Kafka ---
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=erp-boilerplate
KAFKA_GROUP_ID=erp-boilerplate-group

# --- SQS ---
SQS_URL=
SQS_REGION=us-east-1

# --- Outbox ---
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BACKOFF_BASE_MS=1000
OUTBOX_CLEANUP_OLDER_THAN_HOURS=24

# --- Auth (JWT) ---
# Generate secure secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Security ---
SETTINGS_ENCRYPTION_KEY=dev-enc-key-change-me
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
TENANT_HEADER=x-tenant-id
ORGANIZATION_HEADER=x-organization-id

# --- Storage (S3 / MinIO) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=erp-boilerplate
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=900
S3_PUBLIC_BASE_URL=

# --- Observability ---
LOKI_URL=http://localhost:3100
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- AWS (shared credentials) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Notification (SNS / SES) ---
SNS_TOPIC_ARN=
SNS_REGION=us-east-1
SES_REGION=us-east-1
SES_FROM_ADDRESS=
