# ==================================================================
# Example Environment Configuration
# ==================================================================
# Copy this file to `.env.local` (or `.env.production`, `.env.development`)
# and fill in the values for your environment.
# All variables have sensible defaults in the code, but production
# deployments MUST override the security-sensitive values.
# ==================================================================

# --- Application ---
NODE_ENV=development
PORT=4000
API_PREFIX=api
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/erp-boilerplate?schema=public"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=erp-boilerplate

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_URL=amqp://localhost:5672

# --- Auth (JWT) ---
# Generate secure secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Security ---
# AES-256 key for encrypted settings (base64 of 32 bytes)
SETTINGS_ENCRYPTION_KEY=dev-enc-key-change-me
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Storage (S3 / MinIO) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=erp-boilerplate
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# --- External Services ---
# Sentry
SENTRY_DSN=
# Email (AWS SES)
AWS_SES_REGION=us-east-1
# SMS (AWS SNS)
AWS_SNS_REGION=us-east-1
