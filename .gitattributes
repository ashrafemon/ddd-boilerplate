# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts always use LF
*.sh text eol=lf

# Husky hooks always use LF
.husky/* text eol=lf
.husky/_/* text eol=lf

# Config files use LF
*.json text eol=lf
*.json5 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
